    },
    "You earned a new badge." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir rozet kazandın."
          }
        }
      }
    },
    "You may start to feel less anxious and stressed." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaygın ve stresin azalmaya başlayabilir."
          }
        }
      }
    },
    "Your circulation and lung function have improved. Physical activity feels easier." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan dolaşımın ve akciğer fonksiyonun düzelmiştir. Fiziksel aktivite kolaylaşır."
