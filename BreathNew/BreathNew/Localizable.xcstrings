    },
    "Your info is saved automatically. Pack price is your current cigarette pack price." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgilerin kendiliğinden kaydedilir. Paket fiyatı, şu anki sigara paketi fiyatındır."
          }
        }
      }
    },
    "Your risk of coronary heart disease is about half that of a smoker." : {
      "extractionState" : "manual",
